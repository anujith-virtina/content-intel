# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# WordPress (if using WP as CMS for any client)
WP_USERNAME=your-wp-username
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Ghost (if using Ghost)
GHOST_ADMIN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Webflow (if using Webflow)
WEBFLOW_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
WEBFLOW_SITE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
WEBFLOW_COLLECTION_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# LinkedIn / X / social — only if you wire up direct posting via MCP or API
# LINKEDIN_ACCESS_TOKEN=
# X_BEARER_TOKEN=
